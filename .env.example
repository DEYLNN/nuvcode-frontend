# NuvCode Frontend — Environment Variables
# Copy to .env and fill in your values.

# API base URL.
# - Dev (local): leave empty. Vite proxies /admin/api → localhost:7444 automatically.
# - Production: the FULL base including /admin/api suffix.
#   Without the suffix, every API call 404s because the backend routes are under /admin/api/*.
#
# Example: https://nuvcode-router.dkzhen.org/admin/api
VITE_API_BASE=

# Gateway backend URL (for display on Endpoint page — shown to users as the API endpoint).
# No /admin/api suffix here — this is the root URL users connect to with their SDK.
#
# Example: https://nuvcode-router.dkzhen.org
VITE_GATEWAY_BACKEND_URL=
